# 서버 설정
NODE_ENV=test
PORT=3001

# 테스트용 데이터베이스 설정
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=elta_test

# JWT 설정
JWT_SECRET=test_jwt_secret_key_for_testing
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# 로깅 레벨 (debug, info, warn, error)
LOG_LEVEL=error

# 카카오 로그인 설정
KAKAO_CLIENT_ID=test_kakao_client_id
KAKAO_CALLBACK_URL=http://localhost:3001/api/auth/kakao/callback

# 프론트엔드 URL
FRONTEND_URL=http://localhost:3001 