# 베이스 이미지 설정
FROM node:20-alpine AS base

# 기본 환경 변수 설정
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# NestJS 개발 모드에서 파일 변경 감지를 위해 필요할 수 있음
ENV CHOKIDAR_USEPOLLING=true

# pnpm 설치
# RUN npm i -g pnpm@9.6.0  # 특정 버전 대신 최신 안정 버전 사용 권장
RUN npm i -g pnpm

# 빌드 및 네이티브 모듈에 필요한 패키지 설치
# bcrypt 등 네이티브 모듈 컴파일에 필요
RUN apk add --no-cache --virtual .build-deps make gcc g++ python3

# 작업 디렉토리 설정
WORKDIR /app

# 패키지 파일 복사
COPY package.json pnpm-lock.yaml ./

# 의존성 설치 (개발 의존성 포함)
# pnpm 캐시 마운트 활용하여 설치 속도 개선

# 소스 코드 복사
# docker-compose.dev.yml에서 볼륨 마운트를 사용하므로,
# 이 COPY는 초기 이미지 빌드 시 또는 볼륨 마운트 실패 시 대비용
COPY . .

RUN rm -rf node_modules
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
# 네이티브 모듈 재빌드 (node_modules가 복사되거나 설치된 후 실행)
RUN pnpm rebuild bcrypt
# bcrypt 사용하는 경우 주석 해제

# 개발용 실행 명령어 설정
CMD ["pnpm", "run", "start:dev"]