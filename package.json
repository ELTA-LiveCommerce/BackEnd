  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test dotenv -e .env.test -- jest --config ./test/jest-e2e.json",
    "test:e2e:specific": "NODE_ENV=test dotenv -e .env.test -- jest --config ./test/jest-e2e.json -t",
    "test:e2e:setup": "docker-compose -f docker-compose.test.yml up -d",
    "test:e2e:teardown": "docker-compose -f docker-compose.test.yml down",
    "test:e2e:ci": "npm run test:e2e:setup && npm run test:e2e && npm run test:e2e:teardown"
  },
